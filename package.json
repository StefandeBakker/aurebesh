{
  "name": "aurebesh",
  "version": "1.1.0",
  "description": "A lightweight, dependency-free WYSIWYG editor for the web. Rich text, tables, code blocks, images and video, with pluggable uploads. Works in React, Vue, Angular or plain HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefandeBakker/aurebesh.git"
  },
  "homepage": "https://github.com/StefandeBakker/aurebesh#readme",
  "bugs": {
    "url": "https://github.com/StefandeBakker/aurebesh/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "element": [
        "./dist/element.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "angular": [
        "./dist/angular/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/fesm2022/aurebesh-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && npm run build:angular",
    "dev": "tsup --watch",
    "demo": "tsup && serve -l 5199 .",
    "test": "vitest run",
    "test:e2e": "tsup && playwright test",
    "typecheck": "tsc --noEmit && tsc -p angular/tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "capture": "node scripts/capture-server.mjs",
    "build:angular": "ng-packagr -p angular/ng-package.json -c angular/tsconfig.lib.json"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "rich-text",
    "rich-text-editor",
    "contenteditable",
    "web-component",
    "custom-element",
    "table",
    "code-highlighting",
    "html-sanitizer",
    "image-upload",
    "react",
    "vue",
    "angular"
  ],
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@angular/forms": ">=17",
    "react": ">=17",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "ng-packagr": "^20.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "tslib": "^2.8.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "zone.js": "^0.15.1"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/StefandeBakker"
  }
}
