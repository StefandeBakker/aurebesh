{
  "name": "aurebesh",
  "version": "0.1.0-beta.0",
  "description": "A lightweight, dependency-free WYSIWYG editor for the web. Rich text, tables, code blocks, images and video, with pluggable uploads. Works in React, Vue, Angular or plain HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefandeBakker/aurebesh.git"
  },
  "homepage": "https://github.com/StefandeBakker/aurebesh#readme",
  "bugs": {
    "url": "https://github.com/StefandeBakker/aurebesh/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "element": [
        "./dist/element.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "tsup && serve -l 5199 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "rich-text",
    "rich-text-editor",
    "contenteditable",
    "web-component",
    "custom-element",
    "table",
    "code-highlighting",
    "html-sanitizer",
    "image-upload",
    "react",
    "vue",
    "angular"
  ],
  "devDependencies": {
    "jsdom": "^26.0.0",
    "serve": "^14.2.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
